---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`All Posts | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1 style="margin-top: 0;">All Posts</h1>
      <ul style="list-style: none; padding: 0;">
        {posts.map((post) => (
          <li style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
              <a href={`/blog/${post.id}/`} style="font-weight: 600; font-size: 1.1rem;">
                {post.data.title}
              </a>
              <time style="color: var(--muted); font-size: 0.85rem; white-space: nowrap;">
                {post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p style="margin: 0.25rem 0 0; color: var(--muted); font-size: 0.95rem;">
              {post.data.description}
            </p>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
