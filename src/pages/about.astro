---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description="About me and this blog." />
  </head>
  <body>
    <Header />
    <main>
      <h1 style="margin-top: 0;">About</h1>
      <p>
        Welcome to my personal blog. I write about mathematics, machine learning systems,
        and software engineering.
      </p>
      <p>
        Built with Astro, styled with minimal CSS, and deployed automatically on GitHub Pages.
      </p>
    </main>
    <Footer />
  </body>
</html>
