---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description="About me and this blog." />
  </head>
  <body>
    <NeuralBackground />
    <Header />
    <main>
      <p class="kicker">About // Lab Notebook</p>
      <h1 style="margin-top: 0;">About</h1>
      <p>
        Welcome to my lab notebook. I write about machine learning, large language models,
        and the engineering it takes to turn AI experiments into systems people can use —
        training runs, evals, inference, tooling, and the occasional failure post-mortem.
      </p>
    </main>
    <Footer />
  </body>
</html>
