---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description="About me and this blog." />
  </head>
  <body>
    <Header />
    <main>
      <p class="kicker">About // Colophon</p>
      <h1 style="margin-top: 0;">About</h1>
      <p>
        Welcome to my personal notebook. I write about mathematics, machine learning systems,
        and software engineering.
      </p>
      <div class="colophon-box">
        <h2>Colophon</h2>
        <p>
          Typeset in Newsreader and IBM Plex Mono, with equations rendered via KaTeX.
          Built statically with Astro and deployed on GitHub Pages.
        </p>
      </div>
    </main>
    <Footer />
  </body>
</html>
