---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const isPosts = pathname.startsWith('/blog');
const isAbout = pathname.startsWith('/about');
const isHome = pathname === '/';
---

<header class="site-header">
  <div class="masthead-top">
    <a href="/" class="site-title">
      <span class="site-mark" aria-hidden="true">§</span>
      <span>{SITE_TITLE}</span>
    </a>
    <div class="header-right">
      <nav aria-label="Primary">
        <a href="/" class={isHome ? 'active' : ''}>Index</a>
        <a href="/blog/" class={isPosts ? 'active' : ''}>Posts</a>
        <a href="/about/" class={isAbout ? 'active' : ''}>About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle color theme"
      >
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    function syncLabel() {
      const isDark = document.documentElement.dataset.theme === 'dark';
      btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    }

    syncLabel();

    btn.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (_) {}
      syncLabel();
    });
  })();
</script>
